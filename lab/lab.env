# Lab topology and versions. Sourced by every lab/*.sh script (on the Mac and inside the VMs).
DISTRO="ubuntu:noble"          # OrbStack image for all machines
PG_VERSION="17"                # PostgreSQL major version (17+ needed for incremental backups)
PG_NODES="pg1 pg2 pg3"         # Patroni/PostgreSQL/etcd members
BACKUP_HOST="pgbackup"         # backup repository host (WAL archive, base backups, restore tests)
DOMAIN="orb.local"             # OrbStack machine DNS suffix
CLUSTER_NAME="pglab"           # Patroni scope

# Lab-only credentials. Never reuse outside this lab.
PG_SUPERUSER_PASSWORD="lab-postgres"
PG_REPL_PASSWORD="lab-replicator"
PG_BACKUP_PASSWORD="lab-backup"
PG_REWIND_PASSWORD="lab-rewind"
