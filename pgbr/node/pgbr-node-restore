#!/usr/bin/env bash
# In-place point-in-time recovery of THIS node's data directory, as the first step of rebuilding a
# Patroni cluster at an earlier point in time. Run as the postgres OS user, with Patroni stopped on
# every node and the cluster removed from the DCS (see the runbook).
#
#   pgbr-node-restore --target-time 2026-11-23T15:30:00+00:00 [--pause]
#   pgbr-node-restore --resume          # after inspecting a paused recovery: promote and finish
#
# What it does:
#   1. asks the repository which backup fits the target, moves the old data directory aside,
#      streams the backup (full + incrementals already combined) into place
#   2. starts PostgreSQL *without Patroni*, reachable over the local socket only, replaying archived
#      WAL up to the target. The restore_command runs in --strict mode: an unreachable repository
#      aborts recovery instead of being mistaken for the end of WAL.
#   3. promotes (new timeline), checkpoints and shuts down cleanly. Starting Patroni afterwards makes
#      this node the leader of the re-initialised cluster.
. /usr/local/lib/pgbr/node-lib.sh
: "${PGBR_PGDATA:?missing in node.conf}" "${PGBR_PGBIN:?missing in node.conf}"
SOCK=${PGBR_SOCKET_DIR:-/var/run/postgresql}
PORT=${PGBR_PGPORT:-5432}
PGLOG="$PGBR_LOG_DIR/pitr-postgres.log"

die() { nlog "ERROR: $*"; exit 1; }
q() { "$PGBR_PGBIN/psql" -h "$SOCK" -p "$PORT" -d postgres -XAtq -v ON_ERROR_STOP=1 -c "$1"; }

backup="" ttime="" tlsn="" tname="" immediate=0 tl=latest pause=0 resume=0 discard=0
while (( $# )); do
  case $1 in
    --backup) backup=$2; shift 2;;
    --target-time) ttime=$2; shift 2;;
    --target-lsn) tlsn=$2; shift 2;;
    --target-name) tname=$2; shift 2;;
    --immediate) immediate=1; shift;;
    --target-timeline) tl=$2; shift 2;;
    --pause) pause=1; shift;;
    --resume) resume=1; shift;;
    --discard-old-pgdata) discard=1; shift;;
    -h|--help) sed -n '2,18p' "$0"; exit 0;;
    *) die "unknown option $1";;
  esac
done

[[ $(id -un) == postgres ]] || die "run as the postgres OS user"

wait_for_end() { # returns 0 when promoted, 10 when paused at the target
  local st
  while :; do
    "$PGBR_PGBIN/pg_ctl" -D "$PGBR_PGDATA" status >/dev/null 2>&1 \
      || { tail -n 20 "$PGLOG" >&2; die "postgres exited during recovery, see $PGLOG"; }
    st=$(q "select case when not pg_is_in_recovery() then 'promoted' else pg_get_wal_replay_pause_state() end" 2>/dev/null || echo starting)
    [[ $st == promoted ]] && return 0
    [[ $st == paused ]] && return 10
    sleep 2
  done
}

finish() {
  q "checkpoint"
  nlog "recovery complete: now on timeline $(q "select timeline_id from pg_control_checkpoint()"), last replayed commit $(q "select coalesce(pg_last_xact_replay_timestamp()::text, 'n/a')")"
  "$PGBR_PGBIN/pg_ctl" -D "$PGBR_PGDATA" -m fast -w stop >&2
  nlog "PostgreSQL stopped cleanly. Next: start Patroni on this node (it becomes the leader), then on the others."
}

if (( resume )); then
  [[ $(q "select pg_get_wal_replay_pause_state()") == paused ]] || die "recovery is not paused"
  q "select pg_wal_replay_resume()" >/dev/null
  wait_for_end || die "unexpected pause after resume"
  finish
  exit 0
fi

# --- preconditions --------------------------------------------------------------------------
if systemctl is-active --quiet patroni 2>/dev/null; then die "Patroni is running on this node: stop it on ALL nodes first"; fi
if "$PGBR_PGBIN/pg_ctl" -D "$PGBR_PGDATA" status >/dev/null 2>&1; then die "PostgreSQL is running in $PGBR_PGDATA"; fi
[[ -z $tname || -n $backup ]] || die "--target-name needs an explicit --backup"
n=0; [[ -n $ttime ]] && n=$((n+1)); [[ -n $tlsn ]] && n=$((n+1)); [[ -n $tname ]] && n=$((n+1)); (( immediate )) && n=$((n+1))
(( n <= 1 )) || die "give at most one recovery target"
if [[ -n $ttime ]]; then
  [[ $ttime =~ ^[0-9T:.+-]+Z?$ && $ttime =~ (Z|[+-][0-9]{2}(:?[0-9]{2})?)$ ]] \
    || die "--target-time must be ISO 8601 without spaces and with a UTC offset, e.g. 2026-11-23T15:30:00+00:00"
fi

# --- pick + fetch the backup ----------------------------------------------------------------
sel=(--target-timeline="$tl")
[[ -n $backup ]] && sel+=(--backup="$backup")
[[ -n $ttime ]] && sel+=(--target-time="$ttime")
[[ -n $tlsn ]] && sel+=(--target-lsn="$tlsn")
id=$(repo_ssh backup-select "${sel[@]}") || die "the repository has no backup usable for this target"
nlog "using backup $id"

if [[ -d $PGBR_PGDATA && -n $(ls -A "$PGBR_PGDATA" 2>/dev/null) ]]; then
  if (( discard )); then
    nlog "removing old data directory"
    find "$PGBR_PGDATA" -mindepth 1 -delete
  else
    aside="$PGBR_PGDATA.pre-pitr.$(date -u +%Y%m%dT%H%M%S)"
    nlog "moving old data directory to $aside (delete it once the restore is validated)"
    mv "$PGBR_PGDATA" "$aside"
  fi
fi
mkdir -p "$PGBR_PGDATA"; chmod 700 "$PGBR_PGDATA"

nlog "streaming backup $id from the repository"
repo_ssh backup-stream "$id" | zstd -dq | tar -x -C "$PGBR_PGDATA" || die "backup transfer failed"
rm -f "$PGBR_PGDATA/standby.signal" "$PGBR_PGDATA/postmaster.pid" "$PGBR_PGDATA/postmaster.opts"
touch "$PGBR_PGDATA/recovery.signal"

# The backup carries the Patroni-generated postgresql.conf of the node it was taken from, including
# an explicit  recovery_target_xxx = ''  line for every target type. PostgreSQL rejects that next to
# a real target ("multiple recovery targets specified": assigning even an empty value to another
# target type counts). Drop Patroni's recovery block; Patroni rewrites this file when it takes over.
for f in "$PGBR_PGDATA/postgresql.conf" "$PGBR_PGDATA/postgresql.auto.conf"; do
  [[ -f $f ]] && sed -i -E '/^[[:space:]]*(recovery_target[a-z_]*|recovery_min_apply_delay|primary_conninfo|primary_slot_name|restore_command)[[:space:]]*=/d' "$f"
done

# --- recover --------------------------------------------------------------------------------
action=promote; (( pause )) && action=pause
# Options are given on the command line so nothing lingers in the configuration Patroni manages.
opts="-c listen_addresses='' -c primary_conninfo='' -c primary_slot_name=''"
opts+=" -c restore_command='/usr/local/bin/pgbr-archive-get --strict %f %p'"
opts+=" -c recovery_target_timeline='$tl' -c recovery_target_action='$action'"
if   [[ -n $ttime ]]; then opts+=" -c recovery_target_time='$ttime'"
elif [[ -n $tlsn ]];  then opts+=" -c recovery_target_lsn='$tlsn'"
elif [[ -n $tname ]]; then opts+=" -c recovery_target_name='$tname'"
elif (( immediate )); then opts+=" -c recovery_target='immediate'"
fi

nlog "starting PostgreSQL for recovery (socket only), log: $PGLOG"
"$PGBR_PGBIN/pg_ctl" -D "$PGBR_PGDATA" -l "$PGLOG" -w -t 86400 -o "$opts" start >&2 \
  || { tail -n 20 "$PGLOG" >&2; die "PostgreSQL failed to start, see $PGLOG"; }

rc=0; wait_for_end || rc=$?
if (( rc == 10 )); then
  if (( pause )); then
    nlog "recovery is PAUSED at the target (replayed to $(q "select pg_last_wal_replay_lsn()"), last commit $(q "select coalesce(pg_last_xact_replay_timestamp()::text, 'n/a')"))."
    nlog "Inspect it:  psql -h $SOCK -p $PORT    (read only)"
    nlog "Accept it:   pgbr-node-restore --resume"
    nlog "Reject it:   pg_ctl -D $PGBR_PGDATA -m fast stop, then run pgbr-node-restore again with another target"
    exit 0
  fi
  die "recovery paused unexpectedly (hot standby parameter mismatch?), see $PGLOG"
fi
finish
